<?xml version="1.0" encoding="UTF-8" ?>
<Mascot xmlns="http://www.group-finity.com/Mascot" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.group-finity.com/Mascot Mascot.xsd">

    <BehaviorList>
        <Behavior Name="SitAndFaceMouse" Frequency="0" Hidden="true"/>
        <Behavior Name="SitAndSpinHead" Frequency="0" Hidden="true"/>
        <Behavior Name="TelekinesisNigel" Frequency="0" Toggleable="true"
                Condition="#{!mascot.isMouseOwnedByOther() &amp;&amp; !mascot.isGrasping() &amp;&amp; !mascot.environment.isFullscreen() &amp;&amp; !mascot.environment.isMouseLocked()}"/>
        <Behavior Name="TelekinesisWindow" Frequency="0" Toggleable="true"
                Condition="#{!mascot.isMouseOwnedByOther() &amp;&amp; !mascot.isGrasping() &amp;&amp; !mascot.environment.isFullscreen() &amp;&amp; !mascot.environment.isMouseLocked()}"/>
        <Behavior Name="TelekinesisMouse" Frequency="0" Toggleable="true"
                Condition="#{!mascot.isMouseOwnedByOther() &amp;&amp; !mascot.isGrasping() &amp;&amp; !mascot.environment.isFullscreen() &amp;&amp; !mascot.environment.isMouseLocked()}"/>

        <!-- ALWAYS REQUIRED -->
        <Behavior Name="Fall" Frequency="0" Hidden="true"/>

        <!-- ALWAYS REQUIRED -->
        <Behavior Name="Dragged" Frequency="0" Hidden="true"/>

        <!-- ALWAYS REQUIRED -->
        <Behavior Name="Thrown" Frequency="0" Hidden="true"/>

        <Behavior Name="PullUp" Frequency="0" Hidden="true"/>
        <Behavior Name="Divided" Frequency="0" Hidden="true"/>

        <!-- On the Floor -->
        <Condition Condition="#{mascot.environment.floor.isOn(mascot.anchor)}">
            <Behavior Name="StandUp" Frequency="6" Hidden="true"/>
            <Behavior Name="Stare" Frequency="2"/>
            <Behavior Name="FollowLeader" Frequency="1"/>
            <Behavior Name="Meeting" Frequency="1"/>
            <Behavior Name="Floating" Frequency="1"/>
            <Behavior Name="Hanging" Frequency="1"/>
            <Behavior Name="Walk" Frequency="7" Hidden="true"/>
            <Behavior Name="ChaseMouse" Frequency="7" Condition="#{!mascot.isMouseOwnedByOther() &amp;&amp; !mascot.environment.isFullscreen() &amp;&amp; !mascot.environment.isMouseLocked()}"/>
            <Behavior Name="CatchMouse" Frequency="2" Toggleable="true" Condition="#{!mascot.isMouseOwnedByOther() &amp;&amp; !mascot.environment.isFullscreen() &amp;&amp; !mascot.environment.isMouseLocked()}"/>
            <Behavior Name="Telekinesis" Frequency="3" Toggleable="true" Condition="#{!mascot.isMouseOwnedByOther() &amp;&amp; !mascot.isGrasping() &amp;&amp; !mascot.environment.isFullscreen() &amp;&amp; !mascot.environment.isMouseLocked()}"/>
        </Condition>

    </BehaviorList>
</Mascot>
